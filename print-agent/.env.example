WORKER_URL=https://your-worker.example.workers.dev
EVENT_SLUG=your-event-slug
PRINT_AGENT_TOKEN=replace-with-print-agent-token
POLL_INTERVAL_MS=5000
BATCH_SIZE=5
PRINTER_DRIVER=mock
# Required for dnp or dnp-ds620. Find it with: lpstat -p -d
PRINTER_NAME=your-cups-printer-name
# Optional absolute path. Defaults to a stable per-event/printer directory under the user home.
# PRINT_AGENT_STATE_DIR=/absolute/path/to/print-agent-state
