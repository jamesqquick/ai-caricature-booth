{
  "name": "ai-caricature-booth",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "wrangler types && astro check",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ai-caricature-booth-db --local",
