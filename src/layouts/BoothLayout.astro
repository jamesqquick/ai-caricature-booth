---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

type Props = {
  title: string;
  description?: string;
  noIndex?: boolean;
};

const {
  title,
  description = 'Choose a New York scene, take a photo, and preview your caricature postcard.',
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#17191b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('booth-theme');
        const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = savedTheme || systemTheme;
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <slot />
    <script>
      import { isSoundEnabled, setSoundEnabled } from '../lib/sound';

      const toggle = document.querySelector('[data-sound-toggle]');
      const label = document.querySelector('[data-sound-label]');
      const onIcon = document.querySelector('[data-sound-on-icon]');
      const offIcon = document.querySelector('[data-sound-off-icon]');

      if (toggle && label && onIcon && offIcon) {
        const updateSoundToggle = () => {
          const enabled = isSoundEnabled();
          toggle.setAttribute('aria-pressed', String(enabled));
          toggle.setAttribute('aria-label', enabled ? 'Mute sound' : 'Turn sound on');
          toggle.setAttribute('title', enabled ? 'Mute sound' : 'Turn sound on');
          label.textContent = enabled ? 'Sound is on' : 'Sound is off';
          onIcon.classList.toggle('hidden', !enabled);
          offIcon.classList.toggle('hidden', enabled);
        };

        toggle.addEventListener('click', () => {
          setSoundEnabled(!isSoundEnabled());
          updateSoundToggle();
        });

        updateSoundToggle();
      }
    </script>
    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-theme-toggle]');
        const label = document.querySelector('[data-theme-label]');
        const lightIcon = document.querySelector('[data-theme-light-icon]');
        const darkIcon = document.querySelector('[data-theme-dark-icon]');
        if (!toggle || !label || !lightIcon || !darkIcon) return;

        const updateToggle = () => {
          const isLight = document.documentElement.dataset.theme === 'light';
          toggle.setAttribute('aria-pressed', String(isLight));
          toggle.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
          label.textContent = isLight ? 'Switch to dark theme' : 'Switch to light theme';
          lightIcon.classList.toggle('hidden', !isLight);
          darkIcon.classList.toggle('hidden', isLight);
        };

        toggle.addEventListener('click', () => {
          const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = nextTheme;
          localStorage.setItem('booth-theme', nextTheme);
          updateToggle();
        });

        updateToggle();
      })();
    </script>
  </body>
</html>
