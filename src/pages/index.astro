---
import BoothLayout from "../layouts/BoothLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { Button } from "../components/ui/button";
import { Image } from "astro:assets";
import { env } from "cloudflare:workers";
import { loadActiveEvents } from "../db/events";
import { loadScenesByEvent } from "../db/scenes";
import { toPublicScene } from "../data/scenes";
import sfPostcard1 from "../assets/sf-postcard-1.jpg";
import sfPostcard2 from "../assets/sf-postcard-2.jpg";
import sfPostcard3 from "../assets/sf-postcard-3.jpg";

export const prerender = false;

const events = await loadActiveEvents(env.DB);
const sceneSets = await Promise.all(events.map(async (event) => (await loadScenesByEvent(env.DB, event.id)).map(toPublicScene)));
const scenes = sceneSets.find((eventScenes) => eventScenes.length > 0) ?? [];
const featuredScenes = scenes.slice(0, 3);
const galleryScenes = scenes.slice(0, 4);
const featuredPostcards = [sfPostcard1, sfPostcard2, sfPostcard3];
const pipelineStages = [
  {
    title: "Capture",
    label: "Browser camera",
    headline: "Take a selfie.",
    detail: "Take a photo directly in the browser.",
    icons: [{ type: "camera", label: "Browser camera" }],
  },
  {
    title: "Store",
    label: "Cloudflare R2",
    headline: "Store in R2.",
    detail: "Your selfie uploads privately to Cloudflare R2 before any generation begins.",
    icons: [{ src: "/icons/cloudflare/r2.svg", label: "Cloudflare R2" }],
  },
  {
    title: "Check",
    label: "Workers AI",
    headline: "Check for SFW.",
    detail: "Workers AI runs a safety check before your photo moves to the generation step.",
    icons: [{ src: "/icons/cloudflare/workers-ai.svg", label: "Workers AI" }],
  },
  {
    title: "Create",
    label: "Cloudflare Workflows · Replicate",
    headline: "Create caricature.",
    detail: "A Cloudflare Workflow coordinates Replicate as it draws your custom caricature.",
    icons: [
      { src: "/icons/cloudflare/workflows.svg", label: "Cloudflare Workflows" },
    ],
  },
  {
    title: "Overlay",
    label: "Cloudflare Images",
    headline: "Add watermark.",
    detail: "Cloudflare Images adds the watermark and final postcard treatment, ready to download or share.",
    icons: [{ src: "/icons/cloudflare/images.svg", label: "Cloudflare Images" }],
  },
];
---

<BoothLayout
  title="Caricature Booth · AI selfie-to-postcard booth"
  description="Turn a selfie into a custom ink caricature postcard."
>
  <div class="min-h-dvh bg-[radial-gradient(circle_at_78%_15%,color-mix(in_oklch,var(--primary)_11%,transparent),transparent_26rem),var(--background)]">
    <main>
      <section
        class="mx-auto grid min-h-[44rem] w-[min(100%_-_3rem,74rem)] grid-cols-[minmax(0,1fr)_minmax(22rem,1fr)] items-center gap-[clamp(2rem,7vw,7rem)] py-[clamp(4rem,10vw,8rem)] max-[800px]:w-[min(100%_-_2rem,40rem)] max-[800px]:grid-cols-1 max-[800px]:min-h-0 max-[800px]:py-16"
      >
        <div>
          <p
            class="mb-4 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary"
          >
            AI caricature photo booth
          </p>
          <h1
            class="m-0 max-w-[10ch] font-display text-[clamp(3.5rem,7vw,6.8rem)] font-semibold leading-[.9] tracking-[-.07em] max-[800px]:text-[clamp(3.3rem,14vw,5.5rem)]"
          >
            Selfie to postcard.
          </h1>
          <p
            class="mt-7 max-w-xl text-[clamp(1rem,1.5vw,1.15rem)] leading-[1.65] text-muted-foreground"
          >
            Take a selfie, choose a scene, and get a caricature postcard to download
            or share.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-primary px-6 text-base font-extrabold text-primary-foreground no-underline transition-transform duration-200 hover:-translate-y-0.5 hover:bg-primary-hover"
              href="#booths">Choose a booth <span aria-hidden="true">→</span></a
            >
          </div>
        </div>

        <div
          class="relative min-h-[31rem] max-[800px]:min-h-[27rem]"
          aria-label="Example caricature postcards"
        >
          {
            featuredScenes.map((scene, index) => (
              <article
                class={`landing-postcard absolute w-[min(18rem,70%)] overflow-hidden rounded-[.45rem] bg-card text-foreground shadow-[0_2.5rem_5rem_oklch(5%_.01_55_/.5)] ${index === 0 ? 'top-[5%] left-[3%] z-[1]' : index === 1 ? 'top-[18%] right-[4%] z-[2]' : 'bottom-[2%] left-[23%] z-[3]'}`}
                style={`--postcard-rotation: ${index === 0 ? '-8deg' : index === 1 ? '7deg' : '-2deg'}`}
              >
                <div class="landing-postcard-image relative overflow-hidden bg-muted">
                  <Image
                    src={featuredPostcards[index]}
                    alt={`Example ${scene.name} caricature postcard`}
                    width={1800}
                    height={1200}
                    layout="constrained"
                    sizes="(min-width: 801px) 18rem, 70vw"
                    loading={index === 0 ? "eager" : "lazy"}
                    class="block aspect-[3/2] size-full object-cover"
                  />
                </div>
                <div class="flex min-h-[3.8rem] items-center justify-between px-2.5 font-display text-base">
                  <span>{scene.name}</span>
                  <b class="text-[.7rem] tracking-[.12em] text-primary">
                    SF
                  </b>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="mx-auto w-[min(100%_-_3rem,74rem)] border-t border-border py-[clamp(4rem,9vw,7rem)] max-[800px]:w-[min(100%_-_2rem,40rem)]"
        id="how"
      >
        <SectionHeader
          title="How your postcard is made."
        />
        <div class="grid grid-cols-3 gap-px bg-border max-[800px]:grid-cols-1">
          {
            [
              [
                "01 · CAPTURE",
                "Take a photo directly in the browser.",
              ],
              [
                "02 · GENERATE",
                "Select a scene and follow the transformation in real time.",
              ],
              [
                "03 · DELIVER",
                "Download the postcard or share its link.",
              ],
            ].map(([label, copy]) => (
              <article class="min-h-52 bg-background p-6">
                <h3 class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary">
                  {label}
                </h3>
                <p class="mt-9 mb-0 max-w-[28ch] leading-[1.55] text-muted-foreground">
                  {copy}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="mx-auto w-[min(100%_-_3rem,74rem)] border-t border-border py-[clamp(4rem,9vw,7rem)] max-[800px]:w-[min(100%_-_2rem,40rem)]"
        id="gallery"
      >
        <SectionHeader title="Example caricature postcards" />
        <div class="grid grid-cols-4 gap-4 max-[800px]:grid-cols-2">
          {
            galleryScenes.map((scene, index) => (
              <article
                class="overflow-hidden rounded-2xl border border-border bg-card"
              >
                <div class="landing-gallery-image relative grid aspect-[3/2] place-items-center overflow-hidden bg-muted">
                  <span class="font-display text-[5rem] font-semibold text-primary/70" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <small class="absolute left-3 top-3 z-[1] font-label text-[.52rem] tracking-[.14em]">
                    POSTCARD 0{index + 1}
                  </small>
                </div>
                <div class="flex items-center justify-between gap-2 p-4">
                  <>
                    <b class="text-sm">{scene.name}</b>
                    <span class="font-label text-[.58rem] text-muted-foreground">
                      EXAMPLE
                    </span>
                  </>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="mx-auto w-[min(100%_-_3rem,74rem)] border-t border-border py-[clamp(4rem,9vw,7rem)] max-[800px]:w-[min(100%_-_2rem,40rem)]"
        id="booths"
      >
        <SectionHeader
          title="Active booths."
          subtitle="Choose a booth to get started."
        />
        {
          events.length > 0 ? (
            <div class="grid gap-3">
              {events.map((event) => (
                <a
                  class="grid grid-cols-[1fr_auto] items-center gap-6 rounded-2xl border border-border p-5 text-foreground no-underline transition-transform duration-200 hover:-translate-y-0.5 hover:border-primary max-[800px]:grid-cols-[1fr_auto]"
                  href={`/e/${event.slug}`}
                >
                  <div>
                    <h3 class="mb-1.5 font-display text-[1.4rem]">{event.name}</h3>
                    <p class="m-0 text-muted-foreground">{event.tagline}</p>
                  </div>
                  <span>Open booth →</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="m-0 text-muted-foreground">No active booths are available right now.</p>
          )
        }
      </section>

      <section
        class="mx-auto w-[min(100%_-_3rem,74rem)] border-t border-border py-[clamp(4rem,9vw,7rem)] max-[800px]:w-[min(100%_-_2rem,40rem)]"
        id="pipeline"
      >
        <SectionHeader title="How it works" />
        <div class="pipeline-visual relative overflow-hidden border border-border bg-[color-mix(in_oklch,var(--card),var(--background)_34%)]" data-pipeline data-stage="0" role="region" aria-label="Animated image processing pipeline">
          <Button variant="unstyled" size="unstyled" className="pipeline-toggle absolute right-4 top-4 z-20 grid size-11 shrink-0 place-items-center rounded-full border border-border bg-background text-foreground transition-[border-color,color,transform] duration-150 hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-95" type="button" data-pipeline-toggle aria-label="Pause animation" aria-pressed="false">
            <svg data-pipeline-pause-icon viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5" width="3.5" height="14" rx="1"/><rect x="13.5" y="5" width="3.5" height="14" rx="1"/></svg>
            <svg data-pipeline-play-icon viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z"/></svg>
          </Button>
          <div class="grid grid-cols-[minmax(16rem,1fr)_minmax(14rem,.8fr)] items-center gap-[clamp(1.5rem,5vw,5rem)] bg-[radial-gradient(circle_at_25%_50%,color-mix(in_oklch,var(--primary)_14%,transparent),transparent_18rem)] p-[clamp(1.25rem,4vw,3rem)] max-[800px]:grid-cols-1 max-[800px]:pt-16">
            <div class="flex min-h-[15rem] flex-col justify-center p-3">
              <span class="pipeline-result-canvas relative block aspect-[3/2] min-h-0 overflow-hidden border border-dashed border-primary/55 bg-[repeating-linear-gradient(135deg,transparent_0_.55rem,color-mix(in_oklch,var(--primary)_5%,transparent)_.56rem_1.12rem)]" aria-hidden="true">
                <img class="pipeline-result-image" src="/demo-selfie.jpeg" alt="" />
                <img class="pipeline-result-caricature" src="/demo-caricature.jpeg" alt="" />
                <span class="pipeline-result-scan"></span>
                <span class="pipeline-result-ink"></span>
                <span class="pipeline-shutter"></span>
                <span class="pipeline-shutter-flash"></span>
                <span class="pipeline-loader"></span>
                <span class="pipeline-result-details">
                  <span>WATERMARK</span>
                  <span>POSTCARD</span>
                </span>
              </span>
            </div>
            <div class="pipeline-copy-stack self-center">
              {
                pipelineStages.map((stage, index) => (
                  <article class="pipeline-copy" data-pipeline-copy={index} aria-hidden={index !== 0 ? "true" : "false"}>
                    <div class="pipeline-copy-icons" aria-hidden="true">
                      {stage.icons.map((icon) => (
                        "src" in icon ? (
                          <span class="pipeline-product-icon" style={`--pipeline-icon: url('${icon.src}')`}></span>
                        ) : icon.type === "camera" ? (
                          <svg viewBox="0 0 24 24"><path d="M8.5 6 10 4h4l1.5 2H19a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.5Z"/><circle cx="12" cy="12.5" r="3.5"/></svg>
                        ) : null
                      ))}
                    </div>
                    <span class="font-label text-[.62rem] font-extrabold uppercase tracking-[.14em] text-primary">
                      0{index + 1} · {stage.label}
                    </span>
                    <h3 class="mt-3 font-display text-[clamp(1.8rem,4vw,3.6rem)] leading-[.95] tracking-[-.06em]">
                      {stage.headline}
                    </h3>
                    <p class="mt-4 max-w-[34ch] leading-[1.55] text-muted-foreground">
                      {stage.detail}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>

          <div class="pipeline-rail relative grid grid-cols-5 gap-px bg-border max-[800px]:grid-cols-2" role="list" aria-label="Technology pipeline">
            {
              pipelineStages.map((stage, index) => (
                <div class={`pipeline-node relative z-[1] flex min-h-[13rem] flex-col gap-2 border-b-2 border-b-transparent bg-background p-5 transition-[background-color,border-color,transform] duration-200 max-[800px]:min-h-[11rem] ${index === pipelineStages.length - 1 ? 'max-[800px]:col-span-2' : ''}`} data-pipeline-node={index} data-state={index === 0 ? "active" : "pending"} role="listitem" aria-current={index === 0 ? "step" : undefined}>
                  <div class="pipeline-node-icons" aria-hidden="true">
                    {stage.icons.map((icon) => (
                      "src" in icon ? (
                        <span class="pipeline-product-icon" style={`--pipeline-icon: url('${icon.src}')`}></span>
                      ) : icon.type === "camera" ? (
                        <svg viewBox="0 0 24 24"><path d="M8.5 6 10 4h4l1.5 2H19a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.5Z"/><circle cx="12" cy="12.5" r="3.5"/></svg>
                      ) : null
                    ))}
                  </div>
                  <span class="mt-auto font-label text-[.58rem] font-semibold uppercase tracking-[.12em] text-muted-foreground">0{index + 1}</span>
                  <b class="font-display text-[1.05rem] leading-[1.1]">{stage.title}</b>
                  <small class="font-label text-[.58rem] font-semibold uppercase leading-[1.3] tracking-[.08em] text-muted-foreground">{stage.label}</small>
                </div>
              ))
            }
          </div>
          <p class="sr-only">The booth captures your selfie, stores it with Cloudflare R2, checks it with Workers AI, creates a caricature with Cloudflare Workflows and Replicate, then adds the watermark with Cloudflare Images.</p>
        </div>
        <script>
          const pipeline = document.querySelector<HTMLElement>('[data-pipeline]');

          if (pipeline) {
            const pipelineNodes = [...pipeline.querySelectorAll<HTMLElement>('[data-pipeline-node]')];
            const pipelineCopies = [...pipeline.querySelectorAll<HTMLElement>('[data-pipeline-copy]')];
            const toggle = document.querySelector<HTMLButtonElement>('[data-pipeline-toggle]');
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            let pipelineStage = 0;
            let intervalId: number | undefined;
            let isPaused = false;

            const updatePipelineStage = (stageIndex: number, showComplete = false) => {
              pipeline.dataset.stage = String(stageIndex);
              pipelineNodes.forEach((node, index) => {
                const state = showComplete ? 'complete' : index < stageIndex ? 'complete' : index === stageIndex ? 'active' : 'pending';
                node.dataset.state = state;
                if (state === 'active') node.setAttribute('aria-current', 'step');
                else node.removeAttribute('aria-current');
              });
              pipelineCopies.forEach((copy, index) => copy.setAttribute('aria-hidden', String(index !== stageIndex)));
            };

            const stopPipeline = () => {
              if (intervalId !== undefined) window.clearInterval(intervalId);
              intervalId = undefined;
            };

            const schedulePipeline = () => {
              if (reducedMotion.matches || isPaused) return;
              intervalId = window.setInterval(() => {
                pipelineStage = (pipelineStage + 1) % pipelineNodes.length;
                updatePipelineStage(pipelineStage);
              }, 3400);
            };

            const restartStageAnimation = () => {
              delete pipeline.dataset.stage;
              void pipeline.offsetWidth;
              pipeline.dataset.stage = String(pipelineStage);
            };

            const startPipeline = () => {
              stopPipeline();
              isPaused = false;
              pipelineStage = reducedMotion.matches ? 4 : 0;
              updatePipelineStage(pipelineStage, reducedMotion.matches);
              if (toggle) {
                toggle.hidden = reducedMotion.matches;
                toggle.setAttribute('aria-pressed', 'false');
                toggle.setAttribute('aria-label', 'Pause animation');
              }
              pipeline.dataset.paused = 'false';
              schedulePipeline();
            };

            toggle?.addEventListener('click', () => {
              isPaused = !isPaused;
              stopPipeline();
              pipeline.dataset.paused = String(isPaused);
              toggle.setAttribute('aria-pressed', String(isPaused));
              toggle.setAttribute('aria-label', isPaused ? 'Resume animation' : 'Pause animation');
              if (!isPaused) restartStageAnimation();
              schedulePipeline();
            });

            reducedMotion.addEventListener('change', startPipeline);
            window.addEventListener('pagehide', stopPipeline);
            window.addEventListener('pageshow', (event) => {
              if (event.persisted) startPipeline();
            });
            startPipeline();
          }
        </script>
      </section>
    </main>

    <footer
      class="mx-auto flex w-[min(100%_-_3rem,74rem)] justify-between gap-4 border-t border-border py-5 text-[.62rem] font-bold uppercase tracking-[.12em] text-muted-foreground max-[800px]:w-[min(100%_-_2rem,40rem)] max-[800px]:flex-col"
    >
      <span>Built with Cloudflare</span>
    </footer>
  </div>
</BoothLayout>
