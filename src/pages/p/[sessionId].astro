---
import QRCode from "qrcode";
import { env } from "cloudflare:workers";
import BoothLayout from "../../layouts/BoothLayout.astro";
import EventNotFound from "../../components/EventNotFound.astro";
import { loadEventById } from "../../db/events";
import { loadSession } from "../../db/sessions";
import { ReviewTimeoutPrompt } from "../../components/ReviewTimeoutPrompt";
import { AttendeePrintControl } from "../../components/AttendeePrintControl";
import { Toaster } from "../../components/ui/sonner";
import { Button } from "../../components/ui/button";
import { isGenerationReview } from "../../lib/review-entry";

export const prerender = false;

const sessionId = Astro.params.sessionId ?? "";
const isUuid =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    sessionId,
  );
const session = isUuid ? await loadSession(env.DB, sessionId) : null;
const event = session ? await loadEventById(env.DB, session.event_id) : null;
const cameFromGeneration = isGenerationReview(Astro.url.searchParams.get("source"));
const isAvailable = Boolean(
  session && event && session.status === "completed" && session.postcard_key,
);
const resultUrl = new URL(`/p/${sessionId}`, Astro.url).toString();
const postcardUrl = isAvailable
  ? `/api/events/${session!.event_id}/sessions/${sessionId}/postcard`
  : null;
let qrCode: string | null = null;
if (isAvailable) {
  try {
    qrCode = await QRCode.toDataURL(resultUrl, {
      errorCorrectionLevel: "H",
      margin: 2,
      width: 320,
    });
  } catch {
    qrCode = null;
  }
}
const title = isAvailable
  ? `${event!.name} postcard · Caricature Booth`
  : "Postcard not found · Caricature Booth";
---

<BoothLayout
  title={title}
  description="Your finished caricature postcard."
  noIndex
  showNavbar={false}
>
  {
    isAvailable && postcardUrl ? (
       <main class="mx-auto grid min-h-[calc(100dvh-8rem)] w-full max-w-5xl content-start gap-8 px-[clamp(1.25rem,5vw,4rem)] py-[clamp(2rem,7vh,5rem)] max-[1000px]:min-h-0 max-[1000px]:pt-6">
         <h1 class="sr-only">Finished caricature postcard</h1>
          <div class="w-full">
            <figure class="relative m-0 w-full rotate-[1deg] overflow-hidden shadow-[0_2.5rem_6rem_oklch(5%_.01_55_/.55)] max-[1000px]:rotate-[-.8deg]">
              {qrCode && (
                <div class="pointer-events-none absolute right-4 top-4 z-10 rounded-[.35rem] bg-white p-1.5 shadow-[0_.75rem_1.5rem_oklch(5%_.01_55_/.28)] max-[600px]:right-2 max-[600px]:top-2 max-[400px]:right-1.5 max-[400px]:top-1.5 max-[400px]:p-1">
                  <img
                    src={qrCode}
                    alt="QR code to open your digital postcard"
                    width="160"
                    height="160"
                    class="size-24 rounded-[.2rem] max-[600px]:size-16 max-[400px]:size-14"
                  />
                </div>
              )}
              <img
                src={postcardUrl}
               alt={`Finished ${event!.name} caricature postcard`}
               width="1800"
               height="1200"
               class="block aspect-[3/2] h-auto w-full object-contain"
             />
           </figure>
           <div class="mt-5 flex flex-wrap justify-center gap-3 max-[600px]:flex-col max-[600px]:gap-2">
             <a
               class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-transparent bg-[oklch(78%_.14_210)] px-[1.15rem] font-bold text-[oklch(16%_.025_55)] no-underline transition-[background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:rotate-[1deg] hover:border-[oklch(84%_.12_210)] hover:bg-[oklch(84%_.12_210)] hover:shadow-[0_.75rem_2rem_oklch(62%_.14_210_/.25)] active:translate-y-0 max-[600px]:w-full"
               href={`${postcardUrl}?download=1`}
              aria-label="Download postcard"
              title="Download postcard"
            >
                 <svg class="size-[1.15rem] fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
              </svg>
              <span>Download</span>
            </a>
              <Button
                variant="unstyled"
                size="unstyled"
                className="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full border border-[oklch(71%_.2_330)] bg-[oklch(71%_.2_330)] px-[1.15rem] font-bold text-[oklch(16%_.025_55)] transition-[background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:rotate-[-1deg] hover:border-[oklch(77%_.18_330)] hover:bg-[oklch(77%_.18_330)] hover:shadow-[0_.75rem_2rem_oklch(60%_.2_330_/.28)] active:translate-y-0 max-[600px]:w-full"
              type="button"
              data-share
              aria-label="Share postcard"
              title="Share postcard"
            >
                 <svg class="size-[1.15rem] fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round" viewBox="0 0 24 24" aria-hidden="true">
                <>
                  <circle cx="18" cy="5" r="3" />
                  <circle cx="6" cy="12" r="3" />
                  <circle cx="18" cy="19" r="3" />
                  <path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4" />
                </>
              </svg>
              <span>Share</span>
             </Button>
             <AttendeePrintControl client:load eventId={session!.event_id} sessionId={sessionId} />
             <a
               class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-[oklch(82%_.17_85)] bg-[oklch(82%_.17_85)] px-[1.15rem] font-bold text-[oklch(16%_.025_55)] no-underline transition-[background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:rotate-[-.5deg] hover:border-[oklch(88%_.15_85)] hover:bg-[oklch(88%_.15_85)] hover:shadow-[0_.75rem_2rem_oklch(65%_.17_85_/.25)] active:translate-y-0 max-[600px]:w-full"
              href={`/e/${event!.slug}`}
            >
                 <svg class="size-[1.15rem] fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 7v5h-5M4 17v-5h5M6.1 9a7 7 0 0 1 11.5-2.6L20 9M4 15l2.4 2.6A7 7 0 0 0 17.9 15" />
              </svg>
              <span>Start Over</span>
            </a>
          </div>
          <Toaster client:load />
          {cameFromGeneration && <ReviewTimeoutPrompt client:load eventUrl={`/e/${event!.slug}`} />}
        </div>
      </main>
    ) : (
      <EventNotFound />
    )
  }
</BoothLayout>

<script>
  import { toast } from 'sonner';

  const shareButton = document.querySelector<HTMLButtonElement>("[data-share]");
  if (shareButton) {
    shareButton.addEventListener("click", async () => {
      const canonicalUrl = new URL(window.location.pathname, window.location.origin).toString();
      const shareData = {
        title: document.title,
        text: "View my caricature postcard.",
        url: canonicalUrl,
      };
      try {
        if (navigator.share) {
          await navigator.share(shareData);
          toast.success("Postcard shared.");
        } else {
          await navigator.clipboard.writeText(canonicalUrl);
          toast.success("Postcard link copied.");
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError")
          return;
        toast.error("We couldn't share automatically. Copy the URL from your browser.");
      }
    });
  }
</script>
