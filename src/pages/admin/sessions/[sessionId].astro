---
import { env } from 'cloudflare:workers';
import PageHeader from '../../../components/admin/PageHeader.astro';
import SessionImages from '../../../components/admin/SessionImages.astro';
import SessionTimeline from '../../../components/admin/SessionTimeline.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import { loadAdminSession } from '../../../db/admin';
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const sessionId = Astro.params.sessionId ?? '';
const isValidSessionId = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(sessionId);
let session: Awaited<ReturnType<typeof loadAdminSession>> = null;
let loadFailed = false;
if (isValidSessionId) {
  try {
    session = await loadAdminSession(env.DB, sessionId);
  } catch (error) {
    console.error('Admin session detail load failed', error);
    loadFailed = true;
  }
}
const responseStatus = loadFailed ? 503 : isValidSessionId ? (session ? 200 : 404) : 400;
Astro.response.status = responseStatus;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
});
---

<AdminLayout
  title={session ? `Session ${session.id} · Booth Admin` : 'Session not found · Booth Admin'}
  description="Review a booth session's status, timestamps, errors, and images."
>
  {session ? (
    <>
      <PageHeader
        title="Session details"
      />

      <section class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)]" aria-labelledby="session-summary-heading">
        <div class="rounded-[var(--radius-surface)] border border-border bg-card p-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary">Session ID</p>
              <h2 class="mt-2 mb-0 break-all font-label text-lg" id="session-summary-heading">{session.id}</h2>
            </div>
            <StatusBadge status={session.status} />
          </div>
          <dl class="mt-6 grid gap-4 sm:grid-cols-2">
            <div><dt class="font-label text-[.62rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">Event</dt><dd class="mt-1 mb-0 font-semibold">{session.eventName}<span class="mt-1 block font-label text-xs font-normal text-muted-foreground">{session.eventSlug}</span></dd></div>
            <div><dt class="font-label text-[.62rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">Scene</dt><dd class="mt-1 mb-0 font-semibold">{session.sceneName ?? 'Unnamed scene'}<span class="mt-1 block font-label text-xs font-normal text-muted-foreground">{session.sceneId}</span></dd></div>
            <div><dt class="font-label text-[.62rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">Created</dt><dd class="mt-1 mb-0 text-sm text-muted-foreground"><time datetime={new Date(session.createdAt * 1000).toISOString()}>{dateFormatter.format(new Date(session.createdAt * 1000))} UTC</time></dd></div>
            <div><dt class="font-label text-[.62rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">Last updated</dt><dd class="mt-1 mb-0 text-sm text-muted-foreground"><time datetime={new Date(session.updatedAt * 1000).toISOString()}>{dateFormatter.format(new Date(session.updatedAt * 1000))} UTC</time></dd></div>
            <div class="sm:col-span-2"><dt class="font-label text-[.62rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">Workflow ID</dt><dd class="mt-1 mb-0 break-all font-label text-sm text-muted-foreground">{session.workflowId ?? 'Not assigned'}</dd></div>
          </dl>
        </div>

        <aside class="rounded-[var(--radius-surface)] border border-border bg-muted/30 p-6" aria-labelledby="artifacts-heading">
          <p class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary">Saved images</p>
          <h2 class="mt-2 mb-4 font-display text-2xl tracking-[-.04em]" id="artifacts-heading">Images</h2>
          <dl class="grid gap-3">
            {[
              ['Selfie', session.hasSelfie],
              ['Caricature', session.hasCaricature],
              ['Postcard', session.hasPostcard],
            ].map(([label, available]) => (
              <div class="flex items-center justify-between gap-4 border-b border-border/70 pb-3 last:border-0 last:pb-0">
                <dt class="text-sm">{label}</dt>
                <dd class="m-0 font-label text-xs font-bold uppercase tracking-[.08em]" class:text-success={available} class:text-muted-foreground={!available}>{available ? 'Available' : 'Not available'}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-5 mb-0 text-sm leading-[1.55] text-muted-foreground">Saved images appear below.</p>
        </aside>
      </section>

      {session.errorMessage && (
        <section class="mt-6 rounded-[var(--radius-surface)] border border-destructive/40 bg-destructive/10 p-5" role="alert" aria-labelledby="session-error-heading">
          <p class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-destructive">Session error</p>
          <h2 class="mt-2 mb-1 font-display text-xl" id="session-error-heading">Postcard creation failed</h2>
          <p class="m-0 text-sm leading-[1.6] text-muted-foreground">{session.errorMessage}</p>
        </section>
      )}

      <SessionTimeline session={session} />
      <SessionImages session={session} />
      <a class="mt-8 inline-flex min-h-11 items-center rounded-full border border-border px-4 text-sm font-bold text-foreground no-underline hover:border-primary" href="/admin">Back to dashboard</a>
    </>
  ) : (
    <section class="rounded-[var(--radius-surface)] border border-dashed border-border bg-muted/30 p-8 text-center" role="alert">
       <h1 class="m-0 font-display text-3xl">{loadFailed ? 'Unable to load session' : isValidSessionId ? 'Session not found' : 'Invalid session ID'}</h1>
       <p class="mb-0 mt-2 text-muted-foreground">{loadFailed ? "Couldn't load the session. Try again without changing the URL." : isValidSessionId ? 'This session may have been deleted or the URL is incorrect.' : 'Session IDs must use letters, numbers, hyphens, or underscores.'}</p>
       <a class="mt-5 inline-flex min-h-11 items-center rounded-full border border-border px-4 text-sm font-bold text-foreground no-underline hover:border-primary" href={loadFailed ? Astro.url.pathname : '/admin'}>{loadFailed ? 'Retry' : 'Back to dashboard'}</a>
    </section>
  )}
</AdminLayout>
