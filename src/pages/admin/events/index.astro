---
import { env } from 'cloudflare:workers';
import { Plus, RefreshCw } from 'lucide-react';
import EventTable from '../../../components/admin/EventTable.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import { buttonVariants } from '../../../components/ui/button';
import { loadAdminEvents } from '../../../db/events';
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

let events: Awaited<ReturnType<typeof loadAdminEvents>> = [];
let loadFailed = false;
try {
  events = await loadAdminEvents(env.DB);
} catch (error) {
  console.error('Admin events list load failed', error);
  loadFailed = true;
  Astro.response.status = 503;
}
---

<AdminLayout
  title="Events · Booth Admin"
  description="Create events and edit their attendee copy, scenes, prompts, and watermark."
>
  <PageHeader title="Events">
    <a slot="actions" class={buttonVariants({ variant: 'primary', size: 'sm' })} href="/admin/events/new">
      <Plus aria-hidden="true" />
      New event
    </a>
  </PageHeader>
  {loadFailed ? (
    <section class="mt-8 rounded-[var(--radius-surface)] border border-destructive/40 bg-destructive/10 p-6" role="alert">
      <h2 class="m-0 font-display text-xl">Unable to load events</h2>
      <p class="mb-0 mt-2 text-sm text-muted-foreground">Couldn't load events. Try again.</p>
      <a class={buttonVariants({ variant: 'outline', className: 'mt-5' })} href="/admin/events">
        <RefreshCw aria-hidden="true" />
        Retry
      </a>
    </section>
  ) : <EventTable events={events} />}
</AdminLayout>
