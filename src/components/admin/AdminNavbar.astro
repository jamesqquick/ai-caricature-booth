---
import { Menu, Moon, Sun, X } from 'lucide-react';

import { ADMIN_NAV_ITEMS, isAdminNavItemActive } from '../../lib/admin-layout';
import { Button } from '../ui/button';
import { cn } from '../../lib/utils';

const navbarIconHover = 'hover:text-primary [&_svg]:transition-transform [&_svg]:duration-200 hover:[&_svg]:scale-110 hover:[&_svg]:rotate-[4deg] motion-reduce:[&_svg]:transition-none motion-reduce:hover:[&_svg]:scale-100 motion-reduce:hover:[&_svg]:rotate-0';
const navbarHomeIconHover = 'transition-transform duration-200 group-hover:scale-110 group-hover:rotate-[4deg] motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-hover:rotate-0';

type Props = {
  adminEmail: string;
  pathname: string;
};

const { adminEmail, pathname } = Astro.props;
---

<header class="border-b border-border bg-background/95">
  <nav
    class="mx-auto grid w-[min(100%_-_3rem,74rem)] grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-8 py-4 max-[800px]:w-[min(100%_-_2rem,40rem)] max-[800px]:grid-cols-[minmax(0,1fr)_auto] max-[800px]:gap-x-3 max-[800px]:gap-y-4"
    aria-label="Admin navigation"
  >
    <a
      class="group inline-flex min-h-11 w-11 items-center justify-center no-underline"
      href="/"
      aria-label="Caricature Booth home"
    >
      <img class={cn('size-9', navbarHomeIconHover)} src="/favicon.svg" alt="" />
    </a>

    <Button
      className={cn(navbarIconHover, 'hidden text-muted-foreground max-[800px]:inline-flex')}
      variant="outline"
      size="icon"
      type="button"
      data-admin-menu-toggle
      aria-controls="admin-navigation-links"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <Menu aria-hidden="true" />
    </Button>

    <div id="admin-navigation-links" class="contents items-center justify-center gap-1 max-[800px]:fixed max-[800px]:inset-0 max-[800px]:z-50 max-[800px]:flex max-[800px]:flex-col max-[800px]:items-stretch max-[800px]:justify-start max-[800px]:gap-6 max-[800px]:overflow-y-auto max-[800px]:bg-background max-[800px]:p-6" data-admin-menu hidden>
      <div class="hidden max-[800px]:flex max-[800px]:justify-end">
        <Button
          className={cn(navbarIconHover, 'text-muted-foreground')}
          variant="outline"
          size="icon"
          type="button"
          data-admin-menu-close
          aria-label="Close navigation menu"
          title="Close navigation menu"
        >
          <X aria-hidden="true" />
        </Button>
      </div>

      <div class="flex items-center justify-center gap-1 max-[800px]:grid max-[800px]:w-full max-[800px]:grid-cols-1 max-[800px]:gap-3">
      {
        ADMIN_NAV_ITEMS.map((item) => {
          const active = isAdminNavItemActive(pathname, item.href);

          return (
            <a
              class:list={[
                'inline-flex min-h-11 items-center justify-center rounded-full px-4 text-sm font-bold no-underline transition-colors max-[520px]:px-2 max-[520px]:text-xs max-[800px]:w-full',
                active
                  ? 'bg-primary text-primary-foreground'
                  : 'text-muted-foreground hover:bg-muted hover:text-foreground',
              ]}
              href={item.href}
              aria-current={active ? 'page' : undefined}
            >
              {active && <span class="sr-only">Current page: </span>}
              {item.label}
            </a>
          );
        })
      }
      </div>

      <div class="flex min-w-0 items-center justify-end gap-2 max-[800px]:mt-auto max-[800px]:justify-between max-[800px]:border-t max-[800px]:border-border max-[800px]:pt-6">
        <span
          class="max-w-48 overflow-hidden text-ellipsis whitespace-nowrap rounded-full border border-border bg-muted px-3 py-2 font-label text-[.62rem] font-semibold text-muted-foreground max-[520px]:max-w-32"
          title={adminEmail}
          aria-label={`Signed in as ${adminEmail}`}
        >
          {adminEmail}
        </span>
        <Button
          className={cn(navbarIconHover, 'shrink-0 text-muted-foreground')}
          variant="outline"
          size="icon"
          type="button"
          data-theme-toggle
          aria-label="Switch to light theme"
          aria-pressed="false"
          title="Switch theme"
        >
          <Sun className="hidden" data-theme-light-icon aria-hidden="true" />
          <Moon data-theme-dark-icon aria-hidden="true" />
          <span class="sr-only" data-theme-label>Switch to light theme</span>
        </Button>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-admin-menu-toggle]');
    const menu = document.querySelector('[data-admin-menu]');
    const close = document.querySelector('[data-admin-menu-close]');
    if (!toggle || !menu || !close) return;

    const mediaQuery = window.matchMedia('(max-width: 800px)');
    let wasSmall = mediaQuery.matches;
    let previousOverflow = '';
    const setMenuState = (open) => {
      const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (mediaQuery.matches && open && !wasOpen) {
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
      } else if (!open && wasOpen) {
        document.body.style.overflow = previousOverflow;
      }
    };

    const syncMenu = () => {
      toggle.classList.toggle('hidden', !mediaQuery.matches);
      if (mediaQuery.matches) {
        setMenuState(wasSmall && toggle.getAttribute('aria-expanded') === 'true');
      } else {
        setMenuState(false);
        menu.hidden = false;
      }
      wasSmall = mediaQuery.matches;
    };

    toggle.addEventListener('click', () => {
      setMenuState(true);
      close.focus();
    });
    close.addEventListener('click', () => {
      setMenuState(false);
      toggle.focus();
    });
    menu.addEventListener('click', (event) => {
      if (mediaQuery.matches && event.target instanceof HTMLAnchorElement) {
        setMenuState(false);
      }
    });
    document.addEventListener('keydown', (event) => {
      const open = mediaQuery.matches && toggle.getAttribute('aria-expanded') === 'true';
      if (event.key === 'Escape' && open) {
        event.preventDefault();
        setMenuState(false);
        toggle.focus();
        return;
      }
      if (event.key === 'Tab' && open) {
        const focusable = Array.from(menu.querySelectorAll('a[href], button:not([disabled])'));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });
    mediaQuery.addEventListener('change', syncMenu);
    syncMenu();
  })();
</script>
