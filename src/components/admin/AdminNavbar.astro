---
import { ADMIN_NAV_ITEMS, isAdminNavItemActive } from '../../lib/admin-layout';

type Props = {
  adminEmail: string;
  pathname: string;
};

const { adminEmail, pathname } = Astro.props;
---

<header class="border-b border-border bg-background/95">
  <nav
    class="mx-auto grid w-[min(100%_-_3rem,74rem)] grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-8 py-4 max-[800px]:w-[min(100%_-_2rem,40rem)] max-[800px]:grid-cols-[minmax(0,1fr)_auto] max-[800px]:gap-x-3 max-[800px]:gap-y-4"
    aria-label="Admin navigation"
  >
    <a
      class="font-display text-xs font-extrabold uppercase tracking-[.09em] text-foreground no-underline"
      href="/admin"
      aria-label="Caricature Booth admin dashboard"
    >
      Booth Admin
    </a>

    <div class="flex items-center justify-center gap-1 max-[800px]:row-start-2 max-[800px]:col-span-2 max-[800px]:grid max-[800px]:grid-cols-3">
      {
        ADMIN_NAV_ITEMS.map((item) => {
          const active = isAdminNavItemActive(pathname, item.href);

          return (
            <a
              class:list={[
                'inline-flex min-h-11 items-center justify-center rounded-full px-4 text-sm font-bold no-underline transition-colors max-[520px]:px-2 max-[520px]:text-xs',
                active
                  ? 'bg-primary text-primary-foreground'
                  : 'text-muted-foreground hover:bg-muted hover:text-foreground',
              ]}
              href={item.href}
              aria-current={active ? 'page' : undefined}
            >
              {active && <span class="sr-only">Current page: </span>}
              {item.label}
            </a>
          );
        })
      }
    </div>

    <div class="flex min-w-0 items-center justify-end gap-2">
      <span
        class="max-w-48 overflow-hidden text-ellipsis whitespace-nowrap rounded-full border border-border bg-muted px-3 py-2 font-label text-[.62rem] font-semibold text-muted-foreground max-[520px]:max-w-32"
        title={adminEmail}
        aria-label={`Signed in as ${adminEmail}`}
      >
        {adminEmail}
      </span>
      <button
        class="grid size-11 shrink-0 place-items-center rounded-full border border-border bg-transparent text-muted-foreground hover:border-primary hover:text-foreground"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
        aria-pressed="false"
        title="Switch theme"
      >
        <svg class="hidden size-5 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round" data-theme-light-icon aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        <svg class="size-5 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round" data-theme-dark-icon aria-hidden="true" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <span class="sr-only" data-theme-label>Switch to light theme</span>
      </button>
    </div>
  </nav>
</header>
