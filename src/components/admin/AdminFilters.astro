---
import type { AdminEventOption } from '../../db/admin';
import type { SessionStatus } from '../../db/sessions';

type Props = {
  events: AdminEventOption[];
  statuses: readonly SessionStatus[];
  selectedEventId?: number;
  selectedStatus?: SessionStatus;
};

const { events, statuses, selectedEventId, selectedStatus } = Astro.props;

function formatStatus(status: SessionStatus) {
  return status.charAt(0).toUpperCase() + status.slice(1);
}
---

<form class="mt-8 grid grid-cols-[minmax(12rem,1fr)_minmax(12rem,1fr)_auto] items-end gap-3 rounded-[var(--radius-surface)] border border-border bg-card p-5 max-[760px]:grid-cols-1" method="get" action="/admin" aria-label="Dashboard filters" data-admin-filters>
  <label class="grid gap-2 font-label text-[.68rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">
    Event
    <select class="min-h-11 w-full rounded-lg border border-input bg-background px-3 font-sans text-sm normal-case tracking-normal text-foreground focus:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" name="eventId">
      <option value="">All events</option>
      {events.map((event) => <option value={event.id} selected={event.id === selectedEventId}>{event.name}</option>)}
    </select>
  </label>

  <label class="grid gap-2 font-label text-[.68rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground">
    Status
    <select class="min-h-11 w-full rounded-lg border border-input bg-background px-3 font-sans text-sm normal-case tracking-normal text-foreground focus:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" name="status">
      <option value="">All statuses</option>
      {statuses.map((status) => <option value={status} selected={status === selectedStatus}>{formatStatus(status)}</option>)}
    </select>
  </label>

  <noscript>
    <button class="min-h-11 rounded-full bg-primary px-5 text-sm font-extrabold text-primary-foreground hover:bg-primary-hover" type="submit">
      Apply filters
    </button>
  </noscript>
  <a class="inline-flex min-h-11 items-center justify-center rounded-full border border-border px-5 text-sm font-bold text-muted-foreground no-underline hover:border-primary hover:text-foreground" href="/admin">
    Reset
  </a>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-admin-filters]');
  form?.addEventListener('change', (event) => {
    if (!(event.target instanceof HTMLSelectElement)) return;
    form.setAttribute('aria-busy', 'true');
    form.requestSubmit();
  });
</script>
