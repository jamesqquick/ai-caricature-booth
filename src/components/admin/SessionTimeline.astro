---
import type { AdminSessionDetail } from '../../db/admin';
import { SESSION_STATUSES } from '../../db/sessions';
import StatusBadge from './StatusBadge.astro';

type Props = {
  session: AdminSessionDetail;
};

const { session } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
});

function formatTimestamp(timestamp: number) {
  const date = new Date(timestamp * 1000);
  return `${dateFormatter.format(date)} UTC`;
}

const stageLabels: Record<(typeof SESSION_STATUSES)[number], string> = {
  pending: 'Pending',
  uploading: 'Uploading selfie',
  moderating: 'Moderating selfie',
  generating: 'Generating caricature',
  compositing: 'Compositing postcard',
  completed: 'Completed',
  errored: 'Failed',
};
const completedAt = session.completedAt;
---

<section class="mt-8" aria-labelledby="session-timeline-heading">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary">Session status</p>
      <h2 class="mt-2 mb-0 font-display text-[clamp(1.75rem,4vw,2.5rem)] tracking-[-.04em]" id="session-timeline-heading">Status history</h2>
    </div>
    <p class="m-0 max-w-sm text-right text-sm leading-[1.5] text-muted-foreground">The database stores timestamps for the session, updates, and completion.</p>
  </div>

  <ol class="m-0 grid list-none gap-3 p-0">
    {SESSION_STATUSES.map((status) => {
      const isCurrent = session.status === status;
      const isCompleted = status === 'completed' && completedAt !== null;
      return (
        <li class:list={[
          'grid gap-2 rounded-[var(--radius-surface)] border p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center',
          isCurrent ? 'border-primary/50 bg-primary/10' : 'border-border bg-card',
        ]}>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="m-0 font-display text-lg">{stageLabels[status]}</h3>
              {isCurrent && <StatusBadge status={session.status} />}
            </div>
            <p class="mt-1 mb-0 text-sm text-muted-foreground">
              {isCurrent ? 'Current status' : isCompleted ? 'Completion time recorded' : 'No timestamp stored'}
            </p>
          </div>
          <time class="font-label text-xs text-muted-foreground" datetime={isCompleted ? new Date(completedAt * 1000).toISOString() : undefined}>
            {status === 'pending' ? formatTimestamp(session.createdAt) : isCompleted ? formatTimestamp(completedAt) : status === session.status ? formatTimestamp(session.updatedAt) : 'Not available'}
          </time>
        </li>
      );
    })}
  </ol>
</section>
