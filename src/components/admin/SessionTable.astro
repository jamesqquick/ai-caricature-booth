---
import type { AdminSessionSummary } from '../../db/admin';
import StatusBadge from './StatusBadge.astro';

type Props = {
  sessions: AdminSessionSummary[];
  page: number;
  total: number;
  totalPages: number;
  searchParams: URLSearchParams;
};

const { sessions, page, total, totalPages, searchParams } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
});

function pageHref(nextPage: number) {
  const params = new URLSearchParams(searchParams);
  if (nextPage === 1) params.delete('page');
  else params.set('page', String(nextPage));
  const query = params.toString();
  return query ? `/admin?${query}` : '/admin';
}
---

<section class="mt-8" aria-labelledby="latest-jobs-heading">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <p class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary">Live operations</p>
      <h2 class="mt-2 mb-0 font-display text-[clamp(1.75rem,4vw,2.5rem)] tracking-[-.04em]" id="latest-jobs-heading">Latest generation jobs</h2>
    </div>
    <p class="m-0 text-sm text-muted-foreground">{total.toLocaleString('en-US')} {total === 1 ? 'job' : 'jobs'}</p>
  </div>

  {sessions.length === 0 ? (
    <div class="rounded-[var(--radius-surface)] border border-dashed border-border bg-card p-8 text-center">
      <h3 class="m-0 font-display text-xl">No generation jobs found</h3>
      <p class="mt-2 mb-0 text-sm leading-[1.6] text-muted-foreground">No sessions match the current event and status filters.</p>
    </div>
  ) : (
    <>
      <div class="overflow-x-auto rounded-[var(--radius-surface)] border border-border bg-card">
        <table class="w-full min-w-[62rem] border-collapse text-left text-sm">
          <caption class="sr-only">Latest filtered generation jobs</caption>
          <thead class="border-b border-border bg-muted">
            <tr>
              {['Session', 'Event', 'Scene', 'Status', 'Updated', 'Details'].map((heading) => (
                <th class="px-4 py-3 font-label text-[.62rem] font-extrabold uppercase tracking-[.1em] text-muted-foreground" scope="col">{heading}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {sessions.map((session) => {
              const updatedAt = new Date(session.updatedAt * 1000);
              return (
                <tr class="align-top hover:bg-muted/50">
                  <th class="max-w-44 px-4 py-4 font-label text-xs font-semibold" scope="row">
                    <span class="block overflow-hidden text-ellipsis whitespace-nowrap" title={session.id}>{session.id}</span>
                  </th>
                  <td class="px-4 py-4">
                    <span class="block font-semibold">{session.eventName}</span>
                    <span class="mt-1 block font-label text-[.62rem] text-muted-foreground">{session.eventSlug}</span>
                  </td>
                  <td class="px-4 py-4">
                    <span class="block">{session.sceneName ?? 'Unnamed scene'}</span>
                    <span class="mt-1 block font-label text-[.62rem] text-muted-foreground">{session.sceneId}</span>
                  </td>
                  <td class="px-4 py-4"><StatusBadge status={session.status} /></td>
                  <td class="whitespace-nowrap px-4 py-4 text-muted-foreground">
                    <time datetime={updatedAt.toISOString()}>{dateFormatter.format(updatedAt)} UTC</time>
                  </td>
                  <td class="whitespace-nowrap px-4 py-4 text-right">
                    <a class="inline-flex min-h-11 items-center gap-1 rounded-sm px-2 text-sm font-bold text-primary no-underline hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href={`/admin/sessions/${encodeURIComponent(session.id)}`} aria-label={`View details for session ${session.id}`}>
                      View <span aria-hidden="true">&rarr;</span>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {totalPages > 1 && (
        <nav class="mt-4 flex items-center justify-between gap-4" aria-label="Generation jobs pagination">
          {page > 1 ? (
            <a class="inline-flex min-h-11 items-center rounded-full border border-border px-4 text-sm font-bold text-foreground no-underline hover:border-primary" href={pageHref(page - 1)}>Previous</a>
          ) : <span></span>}
          <span class="text-sm text-muted-foreground">Page {page} of {totalPages}</span>
          {page < totalPages ? (
            <a class="inline-flex min-h-11 items-center rounded-full border border-border px-4 text-sm font-bold text-foreground no-underline hover:border-primary" href={pageHref(page + 1)}>Next</a>
          ) : <span></span>}
        </nav>
      )}
    </>
  )}
</section>
