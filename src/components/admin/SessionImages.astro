---
import type { AdminSessionDetail, AdminImageKind } from '../../db/admin';
import { ImagePreview } from './ImagePreview';

type Props = {
  session: AdminSessionDetail;
};

const { session } = Astro.props;
const imageDefinitions: { kind: AdminImageKind; label: string; alt: string; available: boolean }[] = [
  { kind: 'selfie', label: 'Selfie', alt: `Original selfie for session ${session.id}`, available: session.hasSelfie },
  { kind: 'caricature', label: 'Caricature', alt: `Generated caricature for session ${session.id}`, available: session.hasCaricature },
  { kind: 'postcard', label: 'Postcard', alt: `Final postcard for session ${session.id}`, available: session.hasPostcard },
];

function imageUrl(kind: AdminImageKind, download = false) {
  const suffix = download ? '?download=1' : '';
  return `/api/admin/sessions/${encodeURIComponent(session.id)}/images/${kind}${suffix}`;
}
---

<section class="mt-8" aria-labelledby="session-images-heading">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="m-0 font-label text-[.68rem] font-extrabold uppercase tracking-[.14em] text-primary">Generated artifacts</p>
      <h2 class="mt-2 mb-0 font-display text-[clamp(1.75rem,4vw,2.5rem)] tracking-[-.04em]" id="session-images-heading">Image inspection</h2>
    </div>
    <p class="m-0 max-w-sm text-right text-sm leading-[1.5] text-muted-foreground">Private previews are loaded through the authenticated session image proxy.</p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {imageDefinitions.map(({ kind, label, alt, available }) => (
      <article class="rounded-[var(--radius-surface)] border border-border bg-card p-4">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h3 class="m-0 font-display text-xl tracking-[-.03em]">{label}</h3>
          <span class="font-label text-[.62rem] font-extrabold uppercase tracking-[.1em]" class:text-success={available} class:text-muted-foreground={!available}>
            {available ? 'Available' : 'Not available'}
          </span>
        </div>
        {available ? (
          <ImagePreview client:load src={imageUrl(kind)} alt={alt} downloadHref={imageUrl(kind, true)} />
        ) : (
          <div class="flex min-h-56 items-center justify-center rounded-xl border border-dashed border-border bg-muted/30 p-6 text-center">
            <div>
              <p class="m-0 font-label text-xs font-bold uppercase tracking-[.1em] text-muted-foreground">Artifact unavailable</p>
              <p class="mb-0 mt-2 text-sm leading-[1.5] text-muted-foreground">No {label.toLowerCase()} was recorded for this session.</p>
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
</section>
