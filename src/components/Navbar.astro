---
import { Moon, Sun, Volume2, VolumeX } from 'lucide-react';

import { buttonVariants } from './ui/button';
import { cn } from '../lib/utils';

const navbarIconHover = 'hover:text-primary [&_svg]:transition-transform [&_svg]:duration-200 hover:[&_svg]:scale-110 hover:[&_svg]:rotate-[4deg] motion-reduce:[&_svg]:transition-none motion-reduce:hover:[&_svg]:scale-100 motion-reduce:hover:[&_svg]:rotate-0';
const navbarHomeIconHover = 'transition-transform duration-200 group-hover:scale-110 group-hover:rotate-[4deg] motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-hover:rotate-0';
---

<nav
  class="mx-auto flex w-[min(100%_-_3rem,74rem)] items-center justify-between gap-8 border-b border-border py-5 max-[800px]:w-[min(100%_-_2rem,40rem)]"
  aria-label="Main navigation"
>
  <a
    class="group inline-flex size-11 items-center justify-center no-underline"
    href="/"
    aria-label="Caricature Booth home"
  >
    <img class={cn('size-9', navbarHomeIconHover)} src="/favicon.svg" alt="" />
  </a>
  <div
    class="flex items-center gap-3 text-xs font-bold text-muted-foreground max-[800px]:w-full max-[800px]:justify-between"
  >
    <button
      class={cn(
        buttonVariants({ variant: 'outline', size: 'icon' }),
        navbarIconHover,
        'text-muted-foreground max-[800px]:ml-auto',
      )}
      type="button"
      data-sound-toggle
      aria-label="Mute sound"
      aria-pressed="true"
      title="Mute sound"
    >
      <Volume2 data-sound-on-icon aria-hidden="true" />
      <VolumeX className="hidden" data-sound-off-icon aria-hidden="true" />
      <span class="sr-only" data-sound-label>Sound is on</span>
    </button>
    <button
      class={cn(
        buttonVariants({ variant: 'outline', size: 'icon' }),
        navbarIconHover,
        'text-muted-foreground',
      )}
      type="button"
      data-theme-toggle
      aria-label="Switch to light theme"
      aria-pressed="false"
       title="Switch to light theme"
    >
      <Sun className="hidden" data-theme-light-icon aria-hidden="true" />
      <Moon data-theme-dark-icon aria-hidden="true" />
      <span class="sr-only" data-theme-label>Switch to light theme</span>
    </button>
  </div>
</nav>
