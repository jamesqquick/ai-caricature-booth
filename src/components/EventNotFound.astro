<main class="grid min-h-[calc(100dvh-5rem)] place-items-center px-6 py-16">
  <section class="w-full max-w-xl text-center">
    <p
      class="font-label text-xl font-extrabold uppercase tracking-[.14em] text-primary"
    >
      404
    </p>
    <h1
      class="mt-5 font-display text-[clamp(3rem,8vw,6rem)] font-semibold leading-[.9] tracking-[-.07em]"
    >
       Page not found.
    </h1>
    <p
      class="mx-auto mt-7 max-w-md text-lg leading-[1.65] text-muted-foreground"
    >
       This page is unavailable or the link is incorrect.
    </p>
    <a
      class="mt-8 inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-primary px-6 text-base font-extrabold text-primary-foreground no-underline transition-transform duration-200 hover:-translate-y-0.5 hover:bg-primary-hover"
      href="/"
    >
      Back to home <span aria-hidden="true">→</span>
    </a>
  </section>
</main>
