{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-caricature-booth-v2",
  "account_id": "e9bc21da719562a3e45d77de7dd042de",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "vars": {
    "ACCESS_AUD": "f62b95fcf95dce07fb61b7d64381fc36317d10aca666a829c095745c07f83972",
    "ACCESS_TEAM_DOMAIN": "https://cfcommunity.cloudflareaccess.com"
  },
  "secrets": {
    "required": ["PRINT_AGENT_TOKEN", "REPLICATE_API_TOKEN"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/admin", "/api/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-caricature-booth-db",
      "migrations_dir": "./drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SELFIES",
      "bucket_name": "ai-caricature-booth-selfies"
    }
  ],
  "images": {
    "binding": "IMAGES",
    "remote": true
  },
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "caricature-generation",
      "binding": "CARICATURE_WORKFLOW",
      "class_name": "CaricatureWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
